<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <!-- The Web SDK defaults this to true, so packing the solution would warn about this non-packable sample. -->
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    <!--
      Keep package-reference rollups non-fatal; project references still report detailed diagnostics.
      Serilog is not yet fully annotated for trimming and only surfaces as the assembly-level IL2104 rollup,
      while trim and AOT warnings from the Light.PortableResults project references stay fatal in Release.
      Do not set TrimmerSingleWarn=false: it expands Serilog to IL2067, which Release promotes to an error,
      and globally suppressing IL2067 could hide the same defect in the Light assemblies.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104</WarningsNotAsErrors>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Light.PortableResults.AspNetCore.MinimalApis/Light.PortableResults.AspNetCore.MinimalApis.csproj" GlobalPropertiesToRemove="PublishAot" />
    <ProjectReference Include="../../src/Light.PortableResults.AspNetCore.OpenApi/Light.PortableResults.AspNetCore.OpenApi.csproj" GlobalPropertiesToRemove="PublishAot" />
    <ProjectReference Include="../../src/Light.PortableResults.Validation/Light.PortableResults.Validation.csproj" GlobalPropertiesToRemove="PublishAot" />
    <ProjectReference Include="../../src/Light.PortableResults.Validation.OpenApi/Light.PortableResults.Validation.OpenApi.csproj" GlobalPropertiesToRemove="PublishAot" />
    <ProjectReference
      Include="../../src/Light.PortableResults.Validation.OpenApi.SourceGeneration/Light.PortableResults.Validation.OpenApi.SourceGeneration.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Light.SharedCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

</Project>
