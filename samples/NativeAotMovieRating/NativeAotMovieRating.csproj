<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    <!-- Serilog is not yet fully annotated for trimming; suppress the assembly-level IL2104 rollup. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Light.PortableResults.AspNetCore.MinimalApis/Light.PortableResults.AspNetCore.MinimalApis.csproj" GlobalPropertiesToRemove="PublishAot" />
    <ProjectReference Include="../../src/Light.PortableResults.AspNetCore.OpenApi/Light.PortableResults.AspNetCore.OpenApi.csproj" GlobalPropertiesToRemove="PublishAot" />
    <ProjectReference Include="../../src/Light.PortableResults.Validation/Light.PortableResults.Validation.csproj" GlobalPropertiesToRemove="PublishAot" />
    <ProjectReference Include="../../src/Light.PortableResults.Validation.OpenApi/Light.PortableResults.Validation.OpenApi.csproj" GlobalPropertiesToRemove="PublishAot" />
    <ProjectReference
      Include="../../src/Light.PortableResults.Validation.OpenApi.SourceGeneration/Light.PortableResults.Validation.OpenApi.SourceGeneration.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Light.SharedCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!--
      Microsoft.EntityFrameworkCore.Design needs Microsoft.CodeAnalysis.CSharp 5.0.0 at runtime,
      while the centrally managed version is the 4.14.0 that the source generator project builds
      against. Overriding it for this sample only keeps the dotnet-ef tooling working without
      touching the version the generator targets.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

</Project>
