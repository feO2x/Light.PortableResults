<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>OpenAPI bridge package for Light.PortableResults.Validation. Provides built-in validation error metadata contracts and typed helpers for endpoint-specific validation error narrowing.</Description>
    <PackageReleaseNotes>
      Light.PortableResults.Validation.OpenApi 0.7.1
      ---------------------------------------------

      - The help links of the source generator diagnostics LPRSG0001 to LPRSG0016 now point to a dedicated section
        for each diagnostic in docs/openapi.md instead of a README anchor that did not exist.
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Light.PortableResults.AspNetCore.OpenApi\Light.PortableResults.AspNetCore.OpenApi.csproj" />
    <ProjectReference Include="..\Light.PortableResults.Validation\Light.PortableResults.Validation.csproj" />
    <ProjectReference
      Include="..\Light.PortableResults.Validation.OpenApi.SourceGeneration\Light.PortableResults.Validation.OpenApi.SourceGeneration.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
    <None
      Include="..\Light.PortableResults.Validation.OpenApi.SourceGeneration\bin\$(Configuration)\netstandard2.0\Light.PortableResults.Validation.OpenApi.SourceGeneration.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false" />
  </ItemGroup>

</Project>
