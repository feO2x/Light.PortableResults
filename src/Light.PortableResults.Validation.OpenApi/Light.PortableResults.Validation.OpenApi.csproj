<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>OpenAPI bridge package for Light.PortableResults.Validation. Provides built-in validation error metadata contracts and typed helpers for endpoint-specific validation error narrowing.</Description>
    <PackageReleaseNotes>
      Light.PortableResults.Validation.OpenApi 0.5.0
      ----------------------------------------

      - Built-in OpenAPI metadata contracts for Light.PortableResults.Validation error codes.
      - Opt-in registration extension for the global PortableResults OpenAPI contract registry.
      - Typed comparison and range helper metadata contracts for endpoint-specific narrowing.
      - Native AOT compatible.
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Light.PortableResults.AspNetCore.OpenApi\Light.PortableResults.AspNetCore.OpenApi.csproj" />
    <ProjectReference Include="..\Light.PortableResults.Validation\Light.PortableResults.Validation.csproj" />
  </ItemGroup>

</Project>
